{
  "name": "reef-bloom-mac-legacy",
  "productName": "Reef Bloom",
  "version": "1.3.0",
  "description": "Reef Bloom for older Macs (macOS 10.15 Catalina and up) — an Electron shell around the app build.",
  "private": true,
  "main": "main.cjs",
  "author": "Defenestration Technologies LLC",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.defenestrationtech.games.reefbloom.legacy",
    "productName": "Reef Bloom",
    "copyright": "© 2026 Defenestration Technologies LLC",
    "directories": { "output": "dist", "buildResources": "res" },
    "files": ["main.cjs", "app/**/*"],
    "mac": {
      "category": "public.app-category.games",
      "target": [{ "target": "dmg", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }],
      "minimumSystemVersion": "10.15.0",
      "icon": "res/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": { "title": "Reef Bloom", "artifactName": "Reef-Bloom-${version}-macOS-10.15.dmg" },
    "artifactName": "Reef-Bloom-${version}-macOS-10.15.${ext}"
  }
}
